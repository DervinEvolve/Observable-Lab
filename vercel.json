{
  "framework": "vite",
  "devCommand": "vite",
  "functions": {
    "api/epoch/tick.ts": {
      "maxDuration": 800
    },
    "api/epoch/run.ts": {
      "maxDuration": 800
    },
    "api/epoch/clear.ts": {
      "maxDuration": 60
    },
    "api/north/run.ts": {
      "maxDuration": 800
    },
    "api/sprites/exec.ts": {
      "maxDuration": 60
    },
    "api/live-model/v1/chat/completions.ts": {
      "maxDuration": 120
    },
    "api/experiment/trained-chat.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/live-model/v1/models",
      "destination": "/api/live-model/v1/chat/completions"
    }
  ],
  "crons": [
    {
      "path": "/api/epoch/tick",
      "schedule": "0 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "model-proposal/**": false
    }
  }
}
