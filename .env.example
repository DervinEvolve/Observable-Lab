# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Vercel Postgres URL (auto-populated when you add Postgres via Vercel dashboard)
POSTGRES_URL=postgres://...

# Minutes between epochs, measured from the END of the last epoch. Default
# 180 (every 3 hours). The cron fires hourly, and a 10 minute tolerance keeps
# a 180 minute cadence on the 3-hour mark instead of slipping an hour.
EPOCH_INTERVAL_MINUTES=180
# An epoch still marked as running after this many minutes is treated as
# dead (its function hit the time limit) and cleared. Default 50.
EPOCH_STALE_MINUTES=50

# Daily spending cap in US dollars, checked against the real OpenRouter cost
# (usage.cost) recorded for the current UTC day, before each epoch, each code
# contribution and each North run. When it is reached the lab pauses until
# the next UTC midnight. Default 15.
LAB_DAILY_BUDGET_USD=15

# Research beside the classic experiment (docs/OPERATIONS.md, "Research beside
# run 2"). Off unless exactly "true". When on, the hourly tick also advances
# one research experiment: it brings back the archived one so its epoch
# numbers carry on, and holds it to its own daily cap below. When off, the
# tick, the budget and the public state are what they were.
LAB_RESEARCH_ALONGSIDE=false
# The research experiment's own daily cap in US dollars, used only while
# LAB_RESEARCH_ALONGSIDE is on. It counts research spend only (model calls
# plus an estimate of the GPU run), and LAB_DAILY_BUDGET_USD counts
# everything else. Each ledger row keeps the cap it was spent under, so
# turning the flag off does not move research's spend onto the classic cap.
# Over the cap, research waits until the next UTC midnight. Default 40.
LAB_RESEARCH_DAILY_BUDGET_USD=40

# Server-only operator and scheduler credentials. Use separate random values
# of at least 32 characters. Never add a VITE_ prefix to a secret.
# Missing values disable the protected routes.
LAB_OPERATOR_SECRET=
CRON_SECRET=

# Endpoints and owners have no built-in defaults. A feature whose required
# value is empty fails with an error that names the missing variable.

# Optional Sprites integration (operator routes only)
SPRITES_TOKEN=
# Clone URL for the Sprites setup action. Optional when AI_AGENT_GITHUB_OWNER
# is set (then https://github.com/<owner>/<AI_AGENT_GITHUB_REPO>.git is used).
AI_AGENT_REPO=

# Optional legacy Modal API: same token in the observable-lab-web-auth
# Modal secret and this server environment, at least 32 characters.
MODAL_API_TOKEN=
# Required with MODAL_API_TOKEN: your Modal workspace (lowercase).
MODAL_WORKSPACE=
# Optional: the deployed app name, default observable-lab (modal/app.py).
MODAL_APP_NAME=

# Optional autonomous code contributions. Disabled unless explicitly enabled.
# Run 2 sets this to true in the deployment: at most one contribution per
# epoch, for the highest-value approved mutation, while the budget allows.
LAB_ENABLE_CODE_WRITES=false
# Comma-separated numeric IDs of trusted CI workflows in the contribution repo.
LAB_REQUIRED_CI_WORKFLOW_IDS=
AI_AGENT_GITHUB_TOKEN=
# Required: the GitHub user or organisation that owns the contribution repo.
AI_AGENT_GITHUB_OWNER=
# Optional: repository name, default AI-Agent.
AI_AGENT_GITHUB_REPO=

# Optional research runner. Keep URLs free of tokens; requests use Bearer auth.
RESEARCH_GITHUB_TOKEN=
# Owner of the research repo. Falls back to AI_AGENT_GITHUB_OWNER; one of the
# two is required.
RESEARCH_GITHUB_OWNER=
# Optional: repository name, default Research-Lab.
RESEARCH_GITHUB_REPO=
# Required: the https:// URLs Modal prints for your own deployment of
# modal/research_runner.py (start and status endpoints).
RESEARCH_RUNNER_START_URL=
RESEARCH_RUNNER_STATUS_URL=
RESEARCH_RUNNER_TOKEN=
# Training-time target in seconds; default 300, runner accepts 30–600.
RESEARCH_BUDGET_S=300
# How long one research epoch polls the GPU run before giving up for this
# tick (the next tick resumes from the stored call id). Default 400000 ms,
# leaving room inside Vercel's 800 s function limit.
RESEARCH_RUN_POLL_MAX_MS=400000
# Stories from the research loop's best kept model (docs/TOOLS.md, "The
# research model talks"). Off unless this is "true" and
# RESEARCH_RUNNER_MODELS_URL is set. While on, a research run is started with
# a key, the runner saves the model it trains to the Modal Volume
# oblab-research-models, a run kept as the new best has its model promoted,
# and visitors may ask that model for a short story through the public route
# /api/experiment/research-talk. Redeploy modal/research_runner.py first
# (docs/OPERATIONS.md, "Stories from the research model"). Runs made this way
# are marked runner_flow "keep-1" in results.tsv (a fourteenth column from the
# first such run on), in the commit trailers and on the finding page.
LAB_ENABLE_RESEARCH_TALK=false
# The https:// URL Modal prints for the runner's "models" endpoint. It uses
# RESEARCH_RUNNER_TOKEN, like start and status.
RESEARCH_RUNNER_MODELS_URL=
# Stories for all visitors in one UTC day. Default 200, never more than 2000.
# 0 closes the story box and keeps the saving on.
LAB_RESEARCH_TALK_DAILY=200
# New bytes in one story (the model's tokens are single bytes). Default 200,
# 20 to 500.
LAB_RESEARCH_TALK_MAX_NEW=200
# What one story is written to the spend ledger as, in dollars: a flat
# estimate, counted inside LAB_DAILY_BUDGET_USD. Default 0.005, 0 to 0.25.
LAB_RESEARCH_TALK_USD_PER_STORY=0.005
# How the lab scores a research result (README, "How the lab scores results";
# docs/OPERATIONS.md, "Scoring research results"). Off unless exactly "true".
# While on, a run the Reviewer kept, whose val_bpb is below the best, is run
# once more by the lab (the same train.py, unchanged, same runner and
# harness). It becomes the new best only if the mean of the two scores beats
# the best by more than the margin: max(2 x the measured run-to-run noise,
# LAB_RESEARCH_MIN_MARGIN), and never more than LAB_RESEARCH_MAX_MARGIN.
# Otherwise it is recorded as within noise, or not confirmed when the repeat
# gives no score, and train.py stays as it was. The lab also re-runs the
# current best train.py unchanged after an epoch to measure that noise (a
# control run). Each repeat is one more GPU run of RESEARCH_BUDGET_S, counted
# like an epoch's own run, and none is started once the day's cap is reached:
# an epoch whose repeat cannot start waits and repeats the run when the cap
# resets. results.tsv gets five more columns from the first row written while
# this is on, and the research repository gets a file lab-repeats.tsv. No
# runner redeploy is needed.
LAB_RESEARCH_CONFIRM=false
# The least a new best has to beat the old one by, in val_bpb, and the whole
# margin until the noise is measured (three repeated scores). Default 0.002,
# 0 to 1.
LAB_RESEARCH_MIN_MARGIN=0.002
# The most the margin may ever be, in val_bpb. The noise is measured from
# scores the generated train.py prints, so a file that prints wild scores
# could otherwise put the margin out of reach of every real improvement.
# Default 0.05, 0 to 1. A value below LAB_RESEARCH_MIN_MARGIN counts as
# LAB_RESEARCH_MIN_MARGIN. The record says when the ceiling was used.
LAB_RESEARCH_MAX_MARGIN=0.05
# The most research epochs between two control runs, 1 to 1000. Default 10.
# The first three controls follow consecutive epochs so the noise is measured
# soon; never more than one control per epoch, and none while one is running.
LAB_RESEARCH_CONTROL_EVERY=10


# ---------------------------------------------------------------------------
# The tool menu (docs/TOOLS.md). Every tool is off unless its flag is "true"
# AND what it needs is set. Each has a per-day limit (UTC), and everything a
# tool costs is recorded on the spend ledger and counts against
# LAB_DAILY_BUDGET_USD. The prompts describe only the tools that are on.
# ---------------------------------------------------------------------------

# Subagents come with LAB_ENABLE_CODE_WRITES: the Executor chooses 0 to 2
# explorers and whether a test subagent follows. Deployments per day:
LAB_SUBAGENTS_PER_DAY=24

# Sprite sessions: up to 4 shell commands in the Executor's own Sprite (needs
# SPRITES_TOKEN above). Cost is estimated from command time at
# LAB_SPRITE_USD_PER_HOUR (default 1.30, a deliberately high placeholder, not
# a published price: set it from the current Sprites price list).
LAB_ENABLE_SPRITE_SESSIONS=false
LAB_SPRITE_SESSIONS_PER_DAY=8
LAB_SPRITE_USD_PER_HOUR=

# The lab model endpoint (docs/TOOLS.md): an OpenAI-compatible chat
# completions endpoint the lab serves to a model's own Sprite session, at
# <origin>/api/live-model/v1. The models never see OPENROUTER_API_KEY: each
# session gets a scoped key (15 minutes at most, 20 calls, $0.25, revoked when
# the session ends) in LAB_MODEL_API_KEY, with LAB_MODEL_BASE_URL. Off unless
# this is "true"; it also needs Sprite sessions on and OPENROUTER_API_KEY.
LAB_ENABLE_LIVE_MODEL=false
# The models it answers for, comma separated, plain OpenRouter ids only (an id
# with a ":" suffix such as ":online", or under "openrouter/" such as
# "openrouter/auto", is left out: those let OpenRouter choose what is
# called). Default google/gemini-3.8-flash.
LAB_LIVE_MODEL_IDS=
# What the endpoint may spend per UTC day, inside LAB_DAILY_BUDGET_USD.
# Default 1. Spend is OpenRouter's reported usage.cost, never a price table.
LAB_LIVE_MODEL_DAILY_USD=1
# The lab's public address, which a Sprite calls back to: https://<host>, no
# path, port or credentials. When empty, the production domain Vercel reports
# (VERCEL_PROJECT_PRODUCTION_URL) is used.
LAB_PUBLIC_ORIGIN=

# GPU jobs: one short Python script on a Modal A10G through modal/gpu_jobs.py
# (network blocked, no credentials, 120 s hard limit, compiled before any GPU
# time). Same token in the oblab-gpu-jobs-auth Modal secret (JOBS_TOKEN) and
# here, at least 32 characters. URLs are the https:// endpoints Modal prints.
LAB_ENABLE_GPU_JOBS=false
GPU_JOBS_START_URL=
GPU_JOBS_STATUS_URL=
GPU_JOBS_TOKEN=
LAB_GPU_JOBS_PER_DAY=4
# How long an epoch waits for a job's result. Default 300000 ms.
LAB_GPU_JOB_POLL_MAX_MS=300000
# Default 0.000306 (Modal's A10G rate per second when this was written).
LAB_MODAL_GPU_USD_PER_SECOND=

# Public weights for GPU jobs (docs/TOOLS.md, "Public weights"): a model may
# ask for one public Hugging Face repository; the lab's own fetcher in
# modal/gpu_jobs.py checks and downloads it, and a GPU job that names it reads
# it read-only at /weights with the network still blocked. Needs GPU jobs on
# and modal/gpu_jobs.py redeployed. No new URL or token, and no Hugging Face
# token anywhere.
LAB_ENABLE_WEIGHTS=false
LAB_WEIGHTS_PER_DAY=2
# Licenses a repository may state, as Hugging Face writes them. Default (when
# not set): the five below. A list with no usable entry turns the tool off.
LAB_WEIGHTS_LICENSES=apache-2.0,mit,bsd-3-clause,bsd-2-clause,cc-by-4.0
# Largest download and the size of the shelf, in GB (10^9 bytes).
LAB_WEIGHTS_MAX_GB=3
LAB_WEIGHTS_SHELF_GB=30
# How long an epoch waits for a fetch. Default 180000 ms, at most 300000.
LAB_WEIGHTS_POLL_MAX_MS=180000

# Public datasets (docs/TOOLS.md, "Public datasets"): a model may ask for one
# public Hugging Face dataset repository; the lab's own fetcher in
# modal/datasets.py checks it and downloads only its data files (parquet,
# jsonl, json, csv, tsv, txt, arrow; never a loading script or any other
# code). A GPU job that names it reads it read-only at /datasets with the
# network still blocked, and a Tinker training request may take its examples
# from two columns of one file instead of writing them inline. Needs
# modal/datasets.py deployed (its own app, Volume and Modal secret) and GPU
# jobs or Tinker training switched on. No Hugging Face token anywhere.
LAB_ENABLE_DATASETS=false
# The two https:// endpoints Modal prints for modal/datasets.py, and the value
# of JOBS_TOKEN in the Modal secret oblab-datasets-auth.
DATASETS_START_URL=
DATASETS_STATUS_URL=
DATASETS_TOKEN=
LAB_DATASETS_PER_DAY=2
# Licenses a dataset may state, as Hugging Face writes them. Default (when
# not set): the seven below. A list with no usable entry turns the tool off.
LAB_DATASETS_LICENSES=apache-2.0,mit,cc-by-4.0,cc-by-sa-4.0,cc0-1.0,odc-by,bsd-3-clause
# Largest download and the size of the shelf, in GB (10^9 bytes).
LAB_DATASETS_MAX_GB=1
LAB_DATASETS_SHELF_GB=20
# How long an epoch waits for a fetch. Default 180000 ms, at most 300000.
LAB_DATASETS_POLL_MAX_MS=180000
# How long the follow-up waits for the lab's reader before a training run on
# a dataset is given up. Default 150000 ms, at most 240000.
LAB_DATASETS_READ_POLL_MAX_MS=150000
# The lab reads dataset rows for at most LAB_TINKER_PER_DAY training requests
# per UTC day, counted whether or not a run came of the read. No setting of
# its own.
# May the visitor chat (LAB_ENABLE_TRAINED_CHAT) also offer an adapter trained
# on rows of a public dataset? Nobody has read those rows: not a model, not
# the Reviewer, not the owner. Off unless set to true; while off such an
# adapter is not listed and a message that names it is refused.
LAB_TRAINED_CHAT_DATASET_ADAPTERS=false

# Exhibits for the room (docs/EXHIBITS.md): pull requests to AI-Agent adding
# exhibits/<slug>/exhibit.json. Needs LAB_ENABLE_CODE_WRITES, the AI-Agent
# token and owner, and LAB_REQUIRED_CI_WORKFLOW_IDS.
LAB_ENABLE_EXHIBITS=false
LAB_EXHIBITS_PER_DAY=2

# Proposals to the room's own repository, opened as pull requests labelled
# model-proposal and NEVER merged by the lab (SECURITY.md). Use a separate
# fine-grained token for that one repository with Pull requests and Contents
# read/write and nothing else.
LAB_ENABLE_LAB_PROPOSALS=false
LAB_PROPOSALS_GITHUB_TOKEN=
LAB_PROPOSALS_GITHUB_OWNER=
# Optional: repository name, default Observable-Lab.
LAB_PROPOSALS_GITHUB_REPO=
LAB_LAB_PROPOSALS_PER_DAY=1

# Tinker training (docs/TOOLS.md, "Tinker training"): the Executor may ask for
# one LoRA fine-tuning run of a small open-weight model on Tinker (Thinking
# Machines), on chat examples it writes into its answer. The Reviewer approves
# it, and the lab's own runner on Modal (modal/tinker_jobs.py) does the run:
# it holds out part of the data and measures the loss on it before and after.
# Off unless this is "true" and the three runner settings below are set.
LAB_ENABLE_TINKER=false
# The runner's two endpoints, as Modal prints them when modal/tinker_jobs.py is
# deployed, and the token they ask for (the JOBS_TOKEN in the Modal secret
# oblab-tinker-jobs-auth; random, 32+ characters). This token only reaches the
# runner. It is not the Tinker key. When turning the tool off, leave these
# three set until no run is open: the tick keeps collecting runs that were
# already started while they are set, and starts nothing.
TINKER_JOBS_START_URL=
TINKER_JOBS_STATUS_URL=
TINKER_JOBS_TOKEN=
# Base models a request may name, comma separated, from the ones the lab has a
# published price and a chat format for: Qwen/Qwen3.5-4B, Qwen/Qwen3.5-9B,
# Qwen/Qwen3.6-35B-A3B. Default Qwen/Qwen3.5-4B. An id not on that list is
# left out, and a list with nothing usable turns the tool off.
LAB_TINKER_BASE_MODELS=
# Dollar caps. All Tinker costs are ESTIMATES: token counts at the prices
# Tinker published (api/_lib/tinker.ts), because Tinker reports no cost per
# call and its billing page lags by hours. The most a run could cost assumes
# a token for every byte of its text, which no text can exceed, so the amount
# set aside is usually several times what the run then costs. A run is
# refused when the most it could cost is over LAB_TINKER_RUN_USD (default 2,
# never more than 5), or
# would take today's Tinker use over LAB_TINKER_DAILY_USD (default 10, UTC,
# never more than 50). Both sit inside LAB_DAILY_BUDGET_USD.
LAB_TINKER_RUN_USD=2
LAB_TINKER_DAILY_USD=10
# Runs per UTC day, 0 to 10. Default 2. A run counts from the moment it is
# opened, also while it is still training.
LAB_TINKER_PER_DAY=2
# How many days a trained adapter is kept on Tinker, 1 to 30. Default 14.
LAB_TINKER_TTL_DAYS=14
# How long the follow-up waits for a run before a later tick collects it.
# Default 300000 ms, at most 480000.
LAB_TINKER_POLL_MAX_MS=300000

# The Tinker API key, for talking to trained adapters only. It lives in two
# places and no others: this variable (set it as Sensitive, Production) and
# the Modal secret oblab-tinker-auth that the runner trains with (and, when
# adapters can be kept, sets a checkpoint's life and copies its weights with). On this
# server one file reads it (api/_lib/tinker-chat.ts) and it goes into one
# Authorization header to Tinker. It is never sent to a Sprite, a GPU job, a
# prompt, a response, a log or a record. Needed only for the two switches
# below; training does not use it from here.
TINKER_API_KEY=
# Trained adapters on the lab model endpoint, as the models "lab/<name>".
# Needs LAB_ENABLE_LIVE_MODEL and TINKER_API_KEY. Calls count against the
# scoped key's limits, LAB_LIVE_MODEL_DAILY_USD and LAB_TINKER_DAILY_USD.
LAB_ENABLE_LIVE_TRAINED=false
# The visitor chat in the room ("Talk to what they trained"), served by the
# public route /api/experiment/trained-chat. Needs TINKER_API_KEY. Limits are
# fixed in api/_lib/trained-chat.ts: 500 characters a message, 8 turns a
# conversation, 200 tokens a reply; 20 messages in ten minutes and 80 a day
# for one address (an IPv6 address counts as its /64), and within that 10 and
# 40 for one address with one browser string. Counted by keyed hashes, never
# an address. While this is off, a visitor's page never calls the route.
LAB_ENABLE_TRAINED_CHAT=false
# What all visitor chat may cost per UTC day (an estimate, as above), counted
# inside LAB_TINKER_DAILY_USD and LAB_DAILY_BUDGET_USD. Default 1, never more
# than 10. At the cap the chat says so and opens again at 00:00 UTC.
LAB_TINKER_CHAT_DAILY_USD=1

# Names for trained adapters (docs/TOOLS.md, "Naming a trained adapter"): a
# Tinker training request may carry an optional display name, 2 to 40
# characters of letters, digits, spaces, hyphens, apostrophes and dots. A name
# that looks like a web address or a lab id, reads like a real model or
# product, or is the name of another adapter that is still alive is refused
# with the reason stored, and the run goes on without a name. The lab id
# (lab/e<epoch>-<8 hex>) stays the adapter's identity; the name is a label.
# Off unless this is "true". While it is off a "name" in a request is an
# unknown field, as it always was, and no name is shown anywhere.
LAB_ENABLE_TINKER_NAMES=false

# Data origin labels for Tinker training (docs/TOOLS.md, "Where the training
# data came from"). Off unless exactly "true". While on, every training run
# and adapter is labelled "written by the models" (examples a model wrote
# into its request) or "public dataset <repo>@<commit>" (rows the lab read
# from the dataset shelf), in the stored record, the adapter lists and the
# chat panel, and GET /api/experiment/scoring gives the count of runs that
# reached the runner and the median held-out loss before and after training
# per origin. A label
# only: it changes nothing about what a model may train on.
LAB_TINKER_ORIGIN_LABELS=false

# Keeping trained adapters (docs/TOOLS.md, "Keeping a trained adapter"): an
# adapter can be marked to keep by the owner (POST
# /api/experiment/trained-adapters with the operator secret) or by a model
# with the "keep_adapter" tool, which the Reviewer must approve. A kept
# adapter gets a long life on Tinker instead of expiring after
# LAB_TINKER_TTL_DAYS, and a copy of its LoRA weights is written to the lab's
# own Modal Volume oblab-kept-models. Only the owner can unkeep. Off unless
# this is "true" and the three TINKER_JOBS_* settings above are set, and
# modal/tinker_jobs.py is deployed from a version that has the keeper.
# While it is on, every training run also saves its weights on Tinker in the
# form that can be downloaded, which is one more stored checkpoint per run
# until it expires (Tinker stores 100 checkpoints or 100 GB for free).
LAB_ENABLE_TINKER_KEEP=false
# How many adapters may be kept at one time, by the owner and the models
# together. Default 10, at most 40, 0 turns keeping off.
LAB_TINKER_KEEP_MAX=10
# How many keep requests from models are carried out per UTC day, 0 to 10.
# Default 2. An epoch may ask for one. The owner's keeps are not counted here.
LAB_TINKER_KEEPS_PER_DAY=2
# How long a kept adapter stays on Tinker, in days from the day it is kept,
# 30 to 3650. Default 365. After that it expires like any other adapter;
# the copy on the Volume stays.
LAB_TINKER_KEEP_DAYS=365
# The most one copy on the Volume may weigh, in MB, 1 to 4096. Default 1024.
# A LoRA adapter of rank 8 to 32 is tens of MB.
LAB_TINKER_KEEP_MAX_MB=1024
