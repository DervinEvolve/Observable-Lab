# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Vercel Postgres URL (auto-populated when you add Postgres via Vercel dashboard)
POSTGRES_URL=postgres://...

# Epoch interval in minutes (how often the cron triggers a new epoch)
# Use 5 for testing, 60 for production
EPOCH_INTERVAL_MINUTES=60

# Server-only operator and scheduler credentials. Use separate random values
# of at least 32 characters. Never add a VITE_ prefix to a secret.
# Missing values disable the protected routes.
LAB_OPERATOR_SECRET=
CRON_SECRET=

# Endpoints and owners have no built-in defaults. A feature whose required
# value is empty fails with an error that names the missing variable.

# Optional Sprites integration (operator routes only)
SPRITES_TOKEN=
# Clone URL for the Sprites setup action. Optional when AI_AGENT_GITHUB_OWNER
# is set (then https://github.com/<owner>/<AI_AGENT_GITHUB_REPO>.git is used).
AI_AGENT_REPO=

# Optional legacy Modal API: same token in the observable-lab-web-auth
# Modal secret and this server environment, at least 32 characters.
MODAL_API_TOKEN=
# Required with MODAL_API_TOKEN: your Modal workspace (lowercase).
MODAL_WORKSPACE=
# Optional: the deployed app name, default observable-lab (modal/app.py).
MODAL_APP_NAME=

# Optional autonomous code contributions. Disabled unless explicitly enabled.
LAB_ENABLE_CODE_WRITES=false
# Comma-separated numeric IDs of trusted CI workflows in the contribution repo.
LAB_REQUIRED_CI_WORKFLOW_IDS=
AI_AGENT_GITHUB_TOKEN=
# Required: the GitHub user or organisation that owns the contribution repo.
AI_AGENT_GITHUB_OWNER=
# Optional: repository name, default AI-Agent.
AI_AGENT_GITHUB_REPO=

# Optional research runner. Keep URLs free of tokens; requests use Bearer auth.
RESEARCH_GITHUB_TOKEN=
# Owner of the research repo. Falls back to AI_AGENT_GITHUB_OWNER; one of the
# two is required.
RESEARCH_GITHUB_OWNER=
# Optional: repository name, default Research-Lab.
RESEARCH_GITHUB_REPO=
# Required: the https:// URLs Modal prints for your own deployment of
# modal/research_runner.py (start and status endpoints).
RESEARCH_RUNNER_START_URL=
RESEARCH_RUNNER_STATUS_URL=
RESEARCH_RUNNER_TOKEN=
# Training-time target in seconds; default 300, runner accepts 30–600.
RESEARCH_BUDGET_S=300

